#pragma kernel CSMain

Texture2D<float> _Curvature;
StructuredBuffer<uint> _PrevLod;
RWStructuredBuffer<uint> _Lod;
uint2 _ChunkCount;
uint2 _TexSize;
uint _ChunkPixelSize;
float _LodUpHigh;
float _LodDownHigh;
float _LodUpMid;
float _LodDownMid;
float _LodUpLow;
float _LodDownLow;

bool IsTextureBorder(uint2 px)
{
    return px.x == 0 || px.y == 0
        || px.x >= _TexSize.x - 1 || px.y >= _TexSize.y - 1;
}

float MaxCurvatureInChunk(uint2 chunkCoord)
{
    uint2 basePx = chunkCoord * _ChunkPixelSize;
    float m = 0;
    bool any = false;
    for (uint y = 0; y < _ChunkPixelSize; y++)
    {
        for (uint x = 0; x < _ChunkPixelSize; x++)
        {
            uint2 px = basePx + uint2(x, y);
            if (IsTextureBorder(px))
                continue;
            m = max(m, _Curvature[px]);
            any = true;
        }
    }
    if (!any)
    {
        uint2 c = min(basePx + _ChunkPixelSize / 2, _TexSize - 1);
        m = _Curvature[c];
    }
    return m;
}

uint MetricToLod(float m)
{
    if (m > _LodUpHigh) return 0;
    if (m > _LodUpMid) return 1;
    if (m > _LodUpLow) return 2;
    return 3;
}

float DownThreshold(uint lod)
{
    if (lod == 0) return _LodDownHigh;
    if (lod == 1) return _LodDownMid;
    return _LodDownLow;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ChunkCount.x || id.y >= _ChunkCount.y)
        return;

    uint idx = id.y * _ChunkCount.x + id.x;
    float m = MaxCurvatureInChunk(id.xy);
    uint prev = _PrevLod[idx];
    uint target = MetricToLod(m);
    if (target < prev && m < DownThreshold(prev))
        target = prev;
    _Lod[idx] = target;
}
